# Server Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development

# Decider Operating Mode
# Options:
#   classifier - (Default) Production decider loading the trained 22-feature restraint classifier.
#   stub       - Uses local deterministic rule-based adapter for development/testing without real model.
#   real       - Calls the teammate-owned hush_gate module / Strands Decider 2B inference.
HUSH_DECIDER_MODE=classifier

# Custom model artifact path (optional, defaults to data/models/restraint_classifier_v1.json)
# HUSH_MODEL_PATH=data/models/restraint_classifier_v1.json

# Generation Mode
# Options:
#   openai  - (Default) Calls OpenAI or any OpenAI-compatible API (Groq, OpenRouter, Mistral, Ollama).
#   bedrock - Uses Amazon Bedrock Converse API for real text generation.
#   stub    - Uses local offline mock text generation without external API calls or credentials.
HUSH_GENERATION_MODE=openai

# Hosted LLM Configuration (OpenAI or OpenAI-compatible)
# NOTE: Using a real hosted LLM provider requires a valid API key and may incur usage charges from the provider.
OPENAI_API_KEY=
OPENAI_MODEL_ID=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT_SECONDS=15.0

# AWS & Amazon Bedrock Configuration (when HUSH_GENERATION_MODE=bedrock)
# Set these according to your AWS deployment and Bedrock model access permissions.
# Credentials may be omitted if running under an IAM Role or an active AWS CLI profile.
AWS_REGION=
BEDROCK_MODEL_ID=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
BEDROCK_TIMEOUT_SECONDS=15.0

# Frontend CORS
CORS_ORIGINS=http://localhost:5173
