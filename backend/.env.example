# Server Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development

# Decider Operating Mode
# Options:
#   stub - Uses local deterministic rule-based adapter for development/testing without real Decider model.
#   real - Calls the teammate-owned hush_gate module / Strands Decider 2B inference.
HUSH_DECIDER_MODE=stub

# Generation Mode
# Options:
#   stub - Uses local mock text generation without AWS credentials.
#   bedrock - Uses Amazon Bedrock Converse API for real text generation.
HUSH_GENERATION_MODE=stub

# AWS & Amazon Bedrock Configuration
# Set these according to your AWS deployment and Bedrock model access permissions.
# Credentials may be omitted if running under an IAM Role or an active AWS CLI profile.
AWS_REGION=
BEDROCK_MODEL_ID=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Frontend CORS
CORS_ORIGINS=http://localhost:5173
